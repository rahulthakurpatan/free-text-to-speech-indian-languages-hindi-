<script>
    document.addEventListener('DOMContentLoaded', () => {
        const openBtn = document.getElementById('openMobileDrawerBtn');
        const closeBtn = document.getElementById('closeMobileDrawerBtn');
        const wrapper = document.getElementById('mobileDrawerWrapper');
        const overlay = document.getElementById('mobileDrawerOverlay');
        const content = document.getElementById('mobileDrawerContent');

        function openDrawer() {
            // Remove hidden to make it display:block
            wrapper.classList.remove('hidden');
            // Small delay to allow CSS transitions to trigger
            setTimeout(() => {
                overlay.classList.remove('opacity-0');
                overlay.classList.add('opacity-100');
                
                content.classList.remove('-translate-x-full');
                content.classList.add('translate-x-0');
                
                // Prevent background scrolling
                document.body.style.overflow = 'hidden';
            }, 10);
        }

        function closeDrawer() {
            // Start slide out animations
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0');
            
            content.classList.remove('translate-x-0');
            content.classList.add('-translate-x-full');
            
            // Wait for transition to finish before hiding display
            setTimeout(() => {
                wrapper.classList.add('hidden');
                // Restore background scrolling
                document.body.style.overflow = '';
            }, 300); // 300ms matches the CSS duration-300
        }

        if(openBtn) openBtn.addEventListener('click', openDrawer);
        if(closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if(overlay) overlay.addEventListener('click', closeDrawer);
    });
</script>
